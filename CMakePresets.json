{
  "version": 6,
  "configurePresets": [
    {
      "name": "windows-x64",
      "displayName": "SonyConnect Native x64",
      "generator": "Ninja Multi-Config",
      "binaryDir": "${sourceDir}/build/native-ninja",
      "cacheVariables": { "BUILD_TESTING": "ON" }
    }
  ],
  "buildPresets": [
    { "name": "native-debug", "configurePreset": "windows-x64", "configuration": "Debug" },
    { "name": "native-release", "configurePreset": "windows-x64", "configuration": "Release" }
  ],
  "testPresets": [
    { "name": "native-debug", "configurePreset": "windows-x64", "configuration": "Debug", "output": { "outputOnFailure": true } },
    { "name": "native-release", "configurePreset": "windows-x64", "configuration": "Release", "output": { "outputOnFailure": true } }
  ]
}
