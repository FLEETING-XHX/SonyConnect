400 DIALOGEX 0, 0, 460, 340
STYLE DS_SETFONT | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_THICKFRAME | WS_MINIMIZEBOX | WS_MAXIMIZEBOX
EXSTYLE WS_EX_CONTROLPARENT
CAPTION "SonyConnect — 第三方许可"
FONT 10, "Segoe UI"
BEGIN
    LTEXT "完整许可、版权与署名；可离线阅读。Ctrl+A 全选，Ctrl+C 复制选中内容。", 403, 12, 10, 436, 24
    EDITTEXT 401, 12, 38, 436, 266, ES_MULTILINE | ES_AUTOVSCROLL | ES_READONLY | WS_VSCROLL | WS_TABSTOP
    PUSHBUTTON "复制全部(&C)", 402, 290, 314, 76, 20
    DEFPUSHBUTTON "关闭", IDOK, 374, 314, 74, 20
END
